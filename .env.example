TELEGRAM_BOT_TOKEN=123456789:replace_me

# Optional. Defaults to ./storage
# BOT_STORAGE_DIR=storage

# Optional. TGS preview image format for AI inspection: png or webp.
# EMOJI_PREVIEW_FORMAT=png

# Optional. If empty, the first private user who writes to the bot becomes owner.
# OWNER_USER_ID=123456789

# Optional. Push new storage/outbox/*.html files to the owner automatically.
AUTO_PUSH_OUTBOX=1
OUTBOX_POLL_SECONDS=2
